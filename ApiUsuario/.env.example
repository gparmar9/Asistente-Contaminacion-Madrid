APP_NAME=ApiUsuario
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
API_VERSION=1.0.0

# Base de datos del proyecto (RDS en la nube o docker-compose en local)
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/postgres

# Servicio LLMOrchestrator (p. ej. http://localhost:8100).
# Vacía = /chat responde con un stub (sin LLM).
ORCHESTRATOR_URL=
# Debe cubrir el caso típico del bucle del agente (1-2 llamadas al LLM de
# hasta LLM_TIMEOUT_S cada una, con reintentos); ver LLMOrchestrator/.env.example
ORCHESTRATOR_TIMEOUT_S=120

# Servicio Agente (p. ej. http://localhost:8200). Si está definida, /chat y
# /chat/stream van al agente en lugar de a ORCHESTRATOR_URL.
AGENTE_URL=
# Timeout de lectura (segundos sin recibir nada del agente). En /chat/stream el
# agente manda un evento status cada 0,7 s, así que solo salta si se cuelga.
AGENTE_TIMEOUT_S=120
