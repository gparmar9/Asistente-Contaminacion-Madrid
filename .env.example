# --- PostgreSQL en Docker (docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- Conexión que usan los scripts de ingesta / modelos ---
# Debe coincidir con las credenciales de arriba.
DATABASE_URL=postgresql://postgres:cambia_esta_contrasena@localhost:5432/postgres

# --- Contenedores del perfil "api" (docker-compose.yml) ---
# Contraseña del rol de solo lectura agente_lectura, que crea `db-init` y usan el agente y la
# predicción. Sin caracteres especiales (va dentro de una URL de conexión). Si ya creaste el rol
# para `make dev`, pon la misma que en Agente/.env: db-init fija esta contraseña en cada `up`.
AGENTE_LECTURA_CLAVE=cambia_esta_contrasena_lectura
# Puerto del host para la web (nginx): http://localhost:8080
WEB_PORT=8080

# --- Agente: Amazon Bedrock con credenciales de AWS ---
# Los modelos son los de producción (ver docker-compose.yml). Con un perfil de ~/.aws o SSO, en
# lugar de copiar las claves aquí, expórtalas en el terminal antes del `docker compose up`:
#   PowerShell:  aws configure export-credentials --profile TU_PERFIL --format powershell | Invoke-Expression
#   Bash:        eval "$(aws configure export-credentials --profile TU_PERFIL --format env)"
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# --- Servicio RAG (src/rag/api.py): herramienta que consulta el LLM de la API de chat ---
# Distancia coseno máxima para considerar útil un fragmento (calibrada para e5-base con python -m rag.evaluar)
RAG_UMBRAL_DISTANCIA=0.1754
RAG_API_PUERTO=8010
