{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InvocarSoloLaLambdaDelPipeline",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:eu-west-1:*:function:jupiter-pipeline"
    },
    {
      "Sid": "LanzarSoloLosRunbooksDeEncenderYApagarLaRds",
      "Effect": "Allow",
      "Action": "ssm:StartAutomationExecution",
      "Resource": [
        "arn:aws:ssm:eu-west-1::document/AWS-StartRdsInstance",
        "arn:aws:ssm:eu-west-1::document/AWS-StopRdsInstance",
        "arn:aws:ssm:eu-west-1:*:automation-definition/AWS-StartRdsInstance:$DEFAULT",
        "arn:aws:ssm:eu-west-1:*:automation-definition/AWS-StopRdsInstance:$DEFAULT"
      ]
    },
    {
      "Sid": "CrearLaEjecucionDelRunbook",
      "Effect": "Allow",
      "Action": "ssm:StartAutomationExecution",
      "Resource": "arn:aws:ssm:eu-west-1:*:automation-execution/*"
    },
    {
      "Sid": "PasarSoloElRolDeAutomatizacionASystemsManager",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/jupiter-automation-rds",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "ssm.amazonaws.com" }
      }
    }
  ]
}
