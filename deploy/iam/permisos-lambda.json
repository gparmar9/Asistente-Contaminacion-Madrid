{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LeerElModeloEntrenadoDeS3",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::jupiter-calidad-aire-madrid/models/*"
    },
    {
      "Sid": "LeerLaCadenaDeConexionDeSSM",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:eu-west-1:*:parameter/jupiter/*"
    },
    {
      "Sid": "DescifrarElSecretoSoloATravesDeSSM",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "kms:ViaService": "ssm.eu-west-1.amazonaws.com" }
      }
    }
  ]
}
