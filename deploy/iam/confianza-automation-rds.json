{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PermitirQueSystemsManagerAsumaEsteRolSoloDesdeEstaCuenta",
      "Effect": "Allow",
      "Principal": { "Service": "ssm.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "aws:SourceAccount": "<ID_CUENTA>" }
      }
    }
  ]
}
