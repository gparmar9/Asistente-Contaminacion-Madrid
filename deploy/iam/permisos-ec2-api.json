{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LoginEnEcr",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "DescargarSoloLasImagenesDeLaApi",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchGetImage"
      ],
      "Resource": [
        "arn:aws:ecr:eu-west-1:*:repository/jupiter-web",
        "arn:aws:ecr:eu-west-1:*:repository/jupiter-api-usuario",
        "arn:aws:ecr:eu-west-1:*:repository/jupiter-agente",
        "arn:aws:ecr:eu-west-1:*:repository/jupiter-rag",
        "arn:aws:ecr:eu-west-1:*:repository/jupiter-prediccion"
      ]
    },
    {
      "Sid": "LeerSoloLosParametrosQueUsaLaApi",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": [
        "arn:aws:ssm:eu-west-1:*:parameter/jupiter/database_url",
        "arn:aws:ssm:eu-west-1:*:parameter/jupiter/web/contrasena",
        "arn:aws:ssm:eu-west-1:*:parameter/jupiter/versiones/*"
      ]
    },
    {
      "Sid": "LeerLaConfiguracionDelAgente",
      "Effect": "Allow",
      "Action": "ssm:GetParametersByPath",
      "Resource": "arn:aws:ssm:eu-west-1:*:parameter/jupiter/agente"
    },
    {
      "Sid": "DescifrarSecretosSoloATravesDeSSM",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "kms:ViaService": "ssm.eu-west-1.amazonaws.com" }
      }
    },
    {
      "Sid": "InvocarModelosDeBedrockDesdeElAgente",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": "arn:aws:bedrock:eu-west-1::foundation-model/*"
    },
    {
      "Sid": "LeerLosFicherosDeArranqueDeS3",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::jupiter-calidad-aire-madrid/ec2/*"
    },
    {
      "Sid": "EscribirLogsDeLosContenedoresEnSuGrupo",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:eu-west-1:*:log-group:/jupiter/ec2:*"
    },
    {
      "Sid": "PublicarMetricasDeMemoriaYDiscoSoloEnCWAgent",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "cloudwatch:namespace": "CWAgent" }
      }
    }
  ]
}
