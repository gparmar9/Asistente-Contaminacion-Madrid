# Imagen del servicio de predicción (src/prediccion, `python -m prediccion.api`, puerto 8011).
#
# Construir desde la RAÍZ del repositorio (necesita pyproject.toml, src/prediccion, src/etl y models):
#   docker build -f deploy/Dockerfile.prediccion -t jupiter-prediccion .
# Lo que viaja al build lo limita deploy/Dockerfile.prediccion.dockerignore.
#
# La imagen lleva DENTRO los bundles (h1 y h2); lee las mediciones recientes de PostgreSQL
# (DATABASE_URL, vista mediciones_bloques, solo lectura). Mucho más ligera que el RAG: sin torch
# ni Hugging Face, solo el stack de pandas/scikit-learn para la inferencia.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app/src

RUN useradd --create-home --uid 10001 app

WORKDIR /app

# Runtime de la inferencia (mismas versiones que el entorno de entrenamiento: requirements.txt,
# salvo scikit-learn 1.9.1, la versión con la que se crearon los bundles — cargar un .joblib con
# otra versión provoca InconsistentVersionWarning) más el servicio HTTP. Sin pytest ni el
# paquete editable.
RUN pip install \
      pandas==3.0.1 \
      numpy==2.4.3 \
      pyarrow==23.0.1 \
      scikit-learn==1.9.1 \
      SQLAlchemy==2.0.49 \
      psycopg2-binary==2.9.12 \
      fastapi==0.141.1 \
      "uvicorn[standard]"==0.54.0

# Las features/inferencia viven en src/etl (módulos planos); prediccion/__init__ los añade al path.
COPY src/prediccion/ src/prediccion/
COPY src/etl/ src/etl/
COPY models/prediccion_bloques.joblib models/prediccion_bloques_h2.joblib models/

USER app

EXPOSE 8011

# GET /salud carga los bundles y lee el último día de la vista; por eso un start-period holgado.
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8011/salud', timeout=8)"

CMD ["python", "-m", "prediccion.api"]
