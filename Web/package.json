{
  "name": "web-asistente-calidad-aire",
  "private": true,
  "version": "0.1.0",
  "description": "Dashboard y asistente del TFM Calidad del Aire de Madrid (cliente de ApiUsuario)",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "contrato:exportar": "python scripts/exportar_openapi.py",
    "contrato:tipos": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "contrato": "npm run contrato:exportar && npm run contrato:tipos"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^4.0.0"
  }
}
