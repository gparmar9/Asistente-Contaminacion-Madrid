APP_NAME=LLMOrchestrator
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8100
API_VERSION=1.0.0

# Base de datos del proyecto (RDS en la nube o docker-compose en local)
DATABASE_URL=postgresql://usuario:contrasena@localhost:5432/postgres

# Servicio RAG de evidencias (Fase 2), consumido por HTTP.
# Arrancarlo desde la raíz del repo: python -m rag.api   (puerto 8010)
RAG_URL=http://localhost:8010
# Timeout por petición al RAG. La primera petición tras arrancar el servicio
# carga el modelo de embeddings (~1,1 GB) y puede tardar: conviene calentarlo
# (un POST /rag/evidencias de prueba) o dejar margen aquí.
RAG_TIMEOUT_S=60

# Proveedor del LLM: cualquier API OpenAI-compatible. Ejemplos de base_url:
#   Mistral:  https://api.mistral.ai/v1
#   Groq:     https://api.groq.com/openai/v1
#   Gemini:   https://generativelanguage.googleapis.com/v1beta/openai/
#   Ollama:   http://localhost:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Timeout POR INTENTO de cada llamada al LLM (el SDK reintenta 429/5xx hasta
# 2 veces con backoff). Presupuesto: el peor caso de /responder es
# ~3 x LLM_TIMEOUT_S x (MAX_ITERACIONES + 1); el ORCHESTRATOR_TIMEOUT_S de
# ApiUsuario debe cubrir al menos el caso típico de 1-2 llamadas.
LLM_TIMEOUT_S=30

# Vueltas máximas del bucle del agente (cada vuelta = 1 llamada al LLM)
MAX_ITERACIONES=4
