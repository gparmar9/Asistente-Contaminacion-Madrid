APP_NAME=Agente
APP_ENV=development
API_VERSION=0.1.0
API_PORT=8200

# Proveedor del LLM: openai_compatible | bedrock
LLM_PROVEEDOR=openai_compatible
# openai_compatible: cualquier API con interfaz OpenAI (Mistral API, Groq, Ollama...)
LLM_MODELO=
LLM_BASE_URL=
LLM_API_KEY=
# bedrock: LLM_MODELO es el ID del modelo o del perfil de inferencia; credenciales del
# entorno, de AWS_PROFILE o del rol de la instancia EC2 (sin claves en este fichero)
AWS_REGION=eu-west-1
# Solo si usas un perfil de ~/.aws. Nunca vacía: botocore buscaría un perfil llamado "" y fallaría
# AWS_PROFILE=

LLM_TEMPERATURA=0.2
LLM_TIMEOUT_S=30
LLM_MAX_REINTENTOS=2

# Servicio RAG (rag.api), p. ej. http://localhost:8010. Vacía = sin herramienta documental
RAG_URL=
RAG_TIMEOUT_S=20

# Vueltas máximas del bucle de herramientas (cada vuelta = 1 llamada al LLM)
MAX_VUELTAS=3
# Tiempo límite del clasificador de intención (segundos); si se agota, el turno sigue sin clasificar
CLASIFICADOR_TIMEOUT_S=10

# Observabilidad: spans del turno hacia Phoenix y/o un fichero JSONL (ver README)
# Phoenix local: docker compose --profile observabilidad up -d phoenix. Vacía = sin Phoenix
PHOENIX_ENDPOINT=
PHOENIX_PROYECTO=agente
# Carpeta de los JSONL (ignorada por git). Vacía = sin fichero
TRAZAS_RUTA=trazas
# false = prompts, preguntas y respuestas se guardan como __REDACTED__
TRAZA_GUARDAR_TEXTO=true
# true = guarda el razonamiento del modelo si el proveedor lo devuelve
TRAZA_RAZONAMIENTO=false
TRAZA_ETIQUETA=agente
