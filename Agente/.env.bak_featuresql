APP_NAME=Agente
APP_ENV=development
API_VERSION=0.1.0
API_PORT=8200

# Proveedor del LLM: openai_compatible | bedrock
LLM_PROVEEDOR=bedrock
# openai_compatible: cualquier API con interfaz OpenAI (Mistral API, Groq, Ollama...)
LLM_MODELO=mistral.ministral-3-14b-instruct
LLM_BASE_URL=
LLM_API_KEY=
# bedrock: LLM_MODELO es el ID del modelo o del perfil de inferencia; credenciales del
# entorno, de AWS_PROFILE o del rol de la instancia EC2 (sin claves en este fichero)
AWS_REGION=eu-west-1
AWS_PROFILE=pontia

LLM_TEMPERATURA=0.2
LLM_TIMEOUT_S=30
LLM_MAX_REINTENTOS=2

# Servicio RAG (rag.api), p. ej. http://localhost:8010. Vacía = sin herramienta documental
RAG_URL=
RAG_TIMEOUT_S=20

# Vueltas máximas del bucle de herramientas (cada vuelta = 1 llamada al LLM)
MAX_VUELTAS=3
# Tiempo límite del clasificador de intención (segundos); si se agota, el turno sigue sin clasificar
CLASIFICADOR_TIMEOUT_S=10

PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
TRAZAS_RUTA=trazas
